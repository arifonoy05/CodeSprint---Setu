# D34 — the server has no GPU, so models come from providers behind the OmniRoute gateway,
# which compose runs beside Setu. Inside compose that is http://omniroute:20128/v1; the value
# below is for running Setu directly on your machine (npm run dev).
LLM_BASE_URL=http://localhost:20128/v1
# The key you mint in the OmniRoute dashboard. Blank for a local server that wants none.
LLM_API_KEY=
# Left blank on purpose: pick one from the gateway's list in Settings -> Model.
LLM_MODEL=
LLM_REASONING_EFFORT=none
# Must return 768-dimension vectors (the schema stores vector(768)). Runs on CPU, so it can
# stay on a local server even without a GPU — set its endpoint under Settings -> Model -> Advanced.
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# The stored vector width. Changing it needs a migration and a full re-index (see README) —
# on its own it only makes Setu reject the model it was happily using.
EMBED_DIMS=768
DATABASE_URL=postgres://setu:setu@localhost:5433/setu
SESSION_SECRET=change-me-at-least-32-characters-long
# Plain HTTP on a local network: the login cookie is only marked secure without this, and a
# secure cookie is dropped over http, so sign-in fails. Leave blank anywhere TLS is available.
SETU_ALLOW_HTTP=true
# Dashboard login for OmniRoute. Compose refuses to start without it — it holds provider keys.
INITIAL_PASSWORD=
# Optional second gateway, embeddings only: 9router reaches a 768-dim model on a free tier.
# Uncomment to run it; both values below are then required.
# COMPOSE_FILE=docker-compose.yml:docker-compose.9router.yml
NINEROUTER_PASSWORD=
NINEROUTER_JWT_SECRET=
JIRA_PUSH_ENABLED=false
# Jira must be internal too — approved stories carry client business logic (D31).
JIRA_BASE_URL=
JIRA_PROJECT_KEY=SETU
JIRA_TOKEN=
